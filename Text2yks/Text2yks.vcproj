<?xml version="1.0" encoding="shift_jis"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="9.00"
	Name="Text2yks"
	ProjectGUID="{EFCFBDB6-8BD4-4544-89D1-085DC48A98F5}"
	RootNamespace="Text2yks"
	Keyword="Win32Proj"
	TargetFrameworkVersion="196613"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(SolutionDir)build\Text2yks\x86\$(ConfigurationName)"
			IntermediateDirectory="$(SolutionDir)build\Text2yks\x86\$(ConfigurationName)"
			ConfigurationType="2"
			CharacterSet="1"
			>
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="include;..\third_party\pcre2\pcre2-10.39\src;..\third_party\compat\vs2008"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_USRDLL;TEXT2YKS_EXPORTS;PCRE2_CODE_UNIT_WIDTH=8;PCRE2_STATIC"
				MinimalRebuild="false"
				BasicRuntimeChecks="3"
				RuntimeLibrary="1"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				DebugInformationFormat="3"
			/>
			<Tool
				Name="VCLinkerTool"
				OutputFile="$(OutDir)\$(ProjectName)_x86.dll"
				LinkIncremental="1"
				ModuleDefinitionFile=".\Text2yks.def"
				GenerateDebugInformation="true"
				SubSystem="2"
				TargetMachine="1"
			/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(SolutionDir)build\Text2yks\x86\$(ConfigurationName)"
			IntermediateDirectory="$(SolutionDir)build\Text2yks\x86\$(ConfigurationName)"
			ConfigurationType="2"
			CharacterSet="1"
			>
			<Tool
				Name="VCCLCompilerTool"
				Optimization="2"
				EnableIntrinsicFunctions="true"
				AdditionalIncludeDirectories="include;..\third_party\pcre2\pcre2-10.39\src;..\third_party\compat\vs2008"
				PreprocessorDefinitions="WIN32;NDEBUG;_WINDOWS;_USRDLL;TEXT2YKS_EXPORTS;PCRE2_CODE_UNIT_WIDTH=8;PCRE2_STATIC"
				RuntimeLibrary="0"
				EnableFunctionLevelLinking="true"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				DebugInformationFormat="3"
			/>
			<Tool
				Name="VCLinkerTool"
				OutputFile="$(OutDir)\$(ProjectName)_x86.dll"
				LinkIncremental="1"
				ModuleDefinitionFile=".\Text2yks.def"
				GenerateDebugInformation="true"
				SubSystem="2"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				TargetMachine="1"
			/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;def"
			>
			<File RelativePath=".\src\dllmain.cpp" />
			<File RelativePath=".\src\Text2yks.cpp" />
			<File RelativePath=".\Text2yks.def" />
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h"
			>
			<File RelativePath=".\include\Text2yks.h" />
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
